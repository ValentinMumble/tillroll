# Any long random string. Open the site once as /#owner=<this key> to see your own synced spending.
OWNER_KEY=
# Any long random string, production only: Vercel Cron sends it when it runs /api/sync.
CRON_SECRET=
# The Enable Banking application (https://enablebanking.com/cp/applications, Production environment).
ENABLE_BANKING_APP_ID=
# The application's private key: the content of the <app id>.pem file (line breaks may be written \n).
ENABLE_BANKING_PRIVATE_KEY=
# Optional: where the bank sends you back. Defaults to <site>/api/callback, which must be on the application's
# list of redirect URLs. Enable Banking only accepts https addresses, so set it to the production callback
# (https://<your site>/api/callback): `npm run dev` then connects through the site, which shares the store.
ENABLE_BANKING_REDIRECT_URL=
# Optional: the bank to connect, as Enable Banking names it, and its country. Defaults to Revolut in FR.
BANK_NAME=
BANK_COUNTRY=
# Added by Vercel when an Upstash Redis store is connected to the project (`vercel env pull .env.local`).
KV_REST_API_URL=
KV_REST_API_TOKEN=
