{
  "name": "tillroll",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vercel dev --listen 127.0.0.1:5192",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"api/**/*.ts\" local-api.ts vite.config.ts index.html",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"api/**/*.ts\" local-api.ts vite.config.ts index.html"
  },
  "dependencies": {
    "@upstash/redis": "1.39.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}
