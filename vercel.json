{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "vite --port $PORT",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 5 * * *"
    }
  ]
}
